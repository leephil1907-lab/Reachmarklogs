# ============================================================================
# Reachmark Logs — environment template
# Copy to .env (and to apps/api/.env, apps/web/.env) and fill in what you need.
# The web client runs fully offline without any of these; they only matter when
# you flip VITE_API_MODE=live.
# ============================================================================

# ----------------------------------------------------------------- web ------
# local  = seeded store in apps/web/src/data/catalog.js (default, no backend)
# live   = proxy /api to apps/api and /studio-api to services/studio
VITE_API_MODE=local
VITE_BASE_URL=http://localhost:3000
# Where lib/api.js sends live requests. Leave blank to use the same origin
# (the dev server proxies /api to apps/api, which is what the preview uses).
VITE_API_URL=
VITE_STUDIO_URL=http://localhost:8501
VITE_CURRENCY=$

# Clerk (client) — only read in live mode; absent = demo principal
VITE_CLERK_PUBLISHABLE_KEY=

# ----------------------------------------------------------------- api ------
PORT=3000
NODE_ENV=development

# Neon / Postgres
DATABASE_URL=postgresql://user:password@host/reachmark?sslmode=require
DIRECT_URL=postgresql://user:password@host/reachmark?sslmode=require

# Transport selection. Leave blank to auto-detect: a host matching
# neon.tech / neon.build uses the Neon serverless driver (PrismaNeon over
# WebSocket), anything else uses a TCP pool (PrismaPg). Force with neon|pg.
PG_ADAPTER=
# The local dev Postgres (PGlite, `npm run pg:local`) serves one connection at a
# time — keep this at 1 while using it. Raise it for real Postgres or Neon.
PG_POOL_MAX=1
PG_IDLE_MS=30000

# Clerk (server). Absent keys = demo mode: requests carry x-reachmark-auth: demo
# and every authenticated route resolves to a seeded principal.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
# Comma-separated allow-list for the ops desk. Applies to local accounts too, not
# just Clerk: these addresses reach /admin regardless of the role on the account.
ADMIN_EMAILS=ops@reachmarklogs.test
# Plan handed to the demo seller principal (free|pro|premium)
DEMO_PLAN=pro

# ------------------------------------------------------------- copilot ------
# local = deterministic engine only (default; the product is fully usable)
# auto  = use whichever provider key is present
# openai | anthropic | openrouter = force one
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Point any provider at a gateway or a mock (used by scripts/copilot-test.mjs)
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=

# Background jobs (listings colour state, clerk user sync)
INGEST_EVENT_KEY=
INGEST_SIGNING_KEY=

# Media (proof vault uploads)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Escrow / payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REACHMARK_FEE_BPS=750
ESCROW_DEFAULT_DAYS=7

# ------------------------------------------------------------- accounts -----
# local = Reachmark's own email+password accounts (the shipped path).
# demo  = a synthesised principal for fixtures and screenshots; never selected by
#         accident. clerk = defer to Clerk keys.
AUTH_MODE=local
SESSION_TTL_DAYS=30
SESSION_TTL_REMEMBER_DAYS=90
AUTH_TOKEN_TTL_MINUTES=60
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
SESSION_COOKIE_NAME=reachmark_session
# THE ONE TO GET WRONG: this is the base for the links in verification and
# password-reset mail, so it must be the public origin users actually reach. Left
# at localhost, every real user gets an email pointing at their own machine.
#   dev:        http://localhost:5173
#   production: https://reachmarklogs.com
APP_URL=http://localhost:5173
# Seed the demo logins with this password instead of the published default.
DEMO_PASSWORD=

# Mail (transactional: verification results, payout notices)
# --------------------------------------------------------------- mailer -----
# Leave SMTP_USER/SMTP_PASS empty and the API runs in log-only mode: it prints
# the verification and reset links to its own stdout instead of sending them,
# which is how local development and the test suites work with no mail account.
#
# Fill both in and mail is really delivered. Gmail needs an APP PASSWORD, not
# the account password — generate one at https://myaccount.google.com/apppasswords
# (2-step verification must be on). Verify before trusting it:
#
#   npm run mail:verify --workspace apps/api -- --to you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Sender identity. Gmail rewrites (or refuses) a From that is not the mailbox you
# authenticated as, so default this to SMTP_USER.
SENDER_EMAIL=Reachmark Logs <you@gmail.com>
MAIL_FROM=Reachmark Logs <you@gmail.com>
# Becomes the Reply-To on every message, so replies reach a human.
SUPPORT_EMAIL=you@gmail.com
# Set to `quiet` to stop logging one line per delivered message.
MAIL_LOG=

# --------------------------------------------------------------- studio -----
# Proof Studio render service (services/studio — MoneyPrinterTurbo)
HOST=0.0.0.0
STUDIO_PORT=8501
# optional LLM for script drafting
OPENAI_API_KEY=
# optional TTS upgrade (edge-tts works with no key at all)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --------------------------------------------------------------- harvest ----
# Where tools/claw/claw.py looks for the imported repositories
REACHMARK_UPSTREAM=./upstream
