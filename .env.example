# ============================================================================
# Reachmark Logs — environment template
# Copy to .env (and to apps/api/.env, apps/web/.env) and fill in what you need.
# The web client runs fully offline without any of these; they only matter when
# you flip VITE_API_MODE=live.
# ============================================================================

# ----------------------------------------------------------------- web ------
# local  = seeded store in apps/web/src/data/catalog.js (default, no backend)
# live   = proxy /api to apps/api and /studio-api to services/studio
VITE_API_MODE=local
VITE_BASE_URL=http://localhost:3000
# Where lib/api.js sends live requests. Leave blank to use the same origin
# (the dev server proxies /api to apps/api, which is what the preview uses).
VITE_API_URL=
VITE_STUDIO_URL=http://localhost:8501
VITE_CURRENCY=$

# Clerk (client) — only read in live mode; absent = demo principal
VITE_CLERK_PUBLISHABLE_KEY=

# ----------------------------------------------------------------- api ------
PORT=3000
NODE_ENV=development

# Neon / Postgres
DATABASE_URL=postgresql://user:password@host/reachmark?sslmode=require
DIRECT_URL=postgresql://user:password@host/reachmark?sslmode=require

# Transport selection. Leave blank to auto-detect: a host matching
# neon.tech / neon.build uses the Neon serverless driver (PrismaNeon over
# WebSocket), anything else uses a TCP pool (PrismaPg). Force with neon|pg.
PG_ADAPTER=
# The local dev Postgres (PGlite, `npm run pg:local`) serves one connection at a
# time — keep this at 1 while using it. Raise it for real Postgres or Neon.
PG_POOL_MAX=1
PG_IDLE_MS=30000

# Clerk (server). Absent keys = demo mode: requests carry x-reachmark-auth: demo
# and every authenticated route resolves to a seeded principal.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
# Comma-separated allow-list for the ops desk (Clerk email addresses)
ADMIN_EMAILS=ops@reachmarklogs.test
# Plan handed to the demo seller principal (free|pro|premium)
DEMO_PLAN=pro

# ------------------------------------------------------------- copilot ------
# local = deterministic engine only (default; the product is fully usable)
# auto  = use whichever provider key is present
# openai | anthropic | openrouter = force one
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Point any provider at a gateway or a mock (used by scripts/copilot-test.mjs)
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=

# Background jobs (listings colour state, clerk user sync)
INGEST_EVENT_KEY=
INGEST_SIGNING_KEY=

# Media (proof vault uploads)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Escrow / payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REACHMARK_FEE_BPS=750
ESCROW_DEFAULT_DAYS=7

# Mail (transactional: verification results, payout notices)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=desk@reachmarklogs.test
SENDER_EMAIL=desk@reachmarklogs.test

# --------------------------------------------------------------- studio -----
# Proof Studio render service (services/studio — MoneyPrinterTurbo)
HOST=0.0.0.0
STUDIO_PORT=8501
# optional LLM for script drafting
OPENAI_API_KEY=
# optional TTS upgrade (edge-tts works with no key at all)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --------------------------------------------------------------- harvest ----
# Where tools/claw/claw.py looks for the imported repositories
REACHMARK_UPSTREAM=./upstream
