{
  "name": "@reachmark/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Reachmark Logs API \u2014 Express + Prisma service merged from AccountsBazaar (listings, chat, escrow, admin, credential verification) with live Neon + Clerk wiring and the LLM listing copilot.",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "pg:local": "node scripts/dev-postgres.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:copilot": "node scripts/copilot-test.mjs",
    "test:auth": "node scripts/auth-test.mjs",
    "mail:verify": "node scripts/mail-verify.mjs",
    "mail:preview": "node scripts/mail-preview.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.76",
    "@imagekit/nodejs": "^7.12.1",
    "@neondatabase/serverless": "^1.0.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^6.19.3",
    "@reachmark/copilot": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "inngest": "^3.27.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "stripe": "^17.5.0",
    "svix": "^1.42.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": ">=20"
  }
}
