generator client {
    provider = "prisma-client-js"
    // Prisma 6 runs driver adapters without a preview flag; the upstream
    // `previewFeatures = ["driverAdapters"]` line was removed after the warning.
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model User {
    id        String   @id
    email     String   @unique
    name      String
    image     String   @default("")
    earned    Float    @default(0)
    withdrawn Float    @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // ---- Reachmark accounts -------------------------------------------------
    // Upstream AccountsBazaar never stored a credential: identity came entirely
    // from Clerk. Reachmark keeps Clerk as an *option* but ships first-party
    // accounts, so these fields are what make sign-up and sign-in real when no
    // identity provider is configured.
    //
    // `passwordHash` is nullable on purpose: a Clerk-provisioned user has no
    // local password, and neither does a seller created by ops before they set
    // one via the reset link.
    passwordHash  String?
    role          Role      @default(buyer)
    status        UserStatus @default(active)
    emailVerified Boolean   @default(false)
    plan          String    @default("free")
    handle        String?
    bio           String    @default("")
    country       String    @default("")
    timezone      String    @default("")
    lastLoginAt   DateTime?

    // Relations
    Listing       Listing[]
    ownerChats    Chat[]       @relation("OwnerChats")
    chatUserChats Chat[]       @relation("ChatUserChats")
    withdrawals   Withdrawal[]
    sessions      Session[]
    authTokens    AuthToken[]

    @@index([role])
    @@index([createdAt])
}

enum Role {
    buyer
    seller
    admin
}

enum UserStatus {
    active
    suspended
    deactivated
}

/// A signed-in device. Sessions are server-side so that "sign out everywhere",
/// revocation on password change, and a visible device list are all possible —
/// none of which a stateless JWT gives you without extra machinery.
model Session {
    id        String    @id @default(cuid())
    userId    String
    /// sha256 of the bearer token. The raw token exists only in the client's
    /// hands and in the response that created it, never in the database.
    tokenHash String    @unique
    userAgent String    @default("")
    ip        String    @default("")
    createdAt DateTime  @default(now())
    lastSeen  DateTime  @default(now())
    expiresAt DateTime
    revokedAt DateTime?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
}

/// Single-use tokens for email verification and password reset. Same hashing
/// rule as sessions, and each is burned on use so a leaked log line is not a
/// permanent key to the account.
model AuthToken {
    id        String    @id @default(cuid())
    userId    String
    kind      TokenKind
    tokenHash String    @unique
    expiresAt DateTime
    usedAt    DateTime?
    createdAt DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, kind])
}

enum TokenKind {
    verify_email
    reset_password
}

/// Sign-in throttling.
///
/// Keyed by a hash of the email (or the caller's IP) rather than by user id,
/// because the row must exist for addresses that have **no account**. Counting
/// only real users leaks which addresses are registered: an attacker learns it
/// from whether the failure counter moves. Hashing the key means the table is
/// not a list of attempted addresses either.
model LoginAttempt {
    key         String    @id
    count       Int       @default(0)
    lockedUntil DateTime?
    firstAt     DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([lockedUntil])
}

// ---- Reachmark extension ----------------------------------------------------
// AccountsBazaar shipped social platforms only. Reachmark Logs sells "logs"
// across four asset classes, so the enum was widened (additively, so existing
// rows stay valid) and AssetClass was introduced to group them.
enum AssetClass {
    social
    gaming
    streaming
    saas
}

enum Platform {
    // social (upstream)
    youtube
    instagram
    tiktok
    facebook
    twitter
    linkedin
    pinterest
    snapchat
    twitch
    discord
    // gaming
    steam
    riot
    roblox
    epic
    // streaming
    netflix
    spotify
    disney
    crunchyroll
    primevideo
    // aged SaaS & mail
    gmail
    outlook
    adobe
    notion
    microsoft365
}

enum Niche {
    lifestyle
    fitness
    food
    travel
    tech
    gaming
    fashion
    beauty
    business
    education
    entertainment
    music
    art
    sports
    health
    finance
    // Reachmark extension: the upstream enum could not represent these niches,
    // so the seed silently collapsed them (crypto -> finance, auto -> business).
    // That broke live search — the client searched for "crypto" and the API had
    // only ever stored "finance". Enum members are single identifiers, so
    // multi-word niches are stored with underscores and labelled in the DTO.
    auto
    crypto
    real_estate
    pets
    diy
    other
}

enum Status {
    active
    ban
    sold
    deleted
    inactive
}

model Listing {
    id                    String   @id @default(uuid())
    ownerId               String
    title                 String
    platform              Platform
    username              String?
    followers_count       Float
    engagement_rate       Float?
    monthly_views         Float?
    niche                 Niche
    price                 Float
    description           String?
    verified              Boolean  @default(false)
    monetized             Boolean  @default(false)
    country               String?
    age_range             String
    status                Status   @default(active)
    featured              Boolean  @default(false)
    images                String[]
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt
    platformAssured       Boolean  @default(false)
    isCredentialSubmitted Boolean  @default(false)
    isCredentialVerified  Boolean  @default(false)
    isCredentialChanged   Boolean  @default(false)

    // ---- Reachmark extension ------------------------------------------------
    assetClass        AssetClass @default(social)
    handle            String?
    region            String?
    language          String     @default("English")
    audienceSplitPct  Int        @default(0)
    deliveryHours     Int        @default(24)
    escrowDays        Int        @default(7)
    handoverFormat    String?
    proofReelUrl      String?
    viewCount24h      Int        @default(0)
    watcherCount      Int        @default(0)
    offerCount        Int        @default(0)
    fairValueEstimate Float?

    // Relations
    owner           User             @relation(fields: [ownerId], references: [id])
    chats           Chat[]
    transactions    Transaction[]
    proofArtifacts  ProofArtifact[]
    credentialChain CredentialEvent[]
}

// User can have multiple chats
model Chat {
    id                  String            @id @default(uuid())
    chatUserId          String
    ownerUserId         String
    listingId           String
    messages            Message[]
    platformMessages    PlatformMessage[]
    createdAt           DateTime          @default(now())
    updatedAt           DateTime          @updatedAt
    active              Boolean           @default(true)
    lastMessage         String            @default("")
    isLastMessageRead   Boolean           @default(true)
    lastMessageSenderId String            @default("")
    isTokenAmountPaid   Boolean           @default(false)

    // Relations
    ownerUser User    @relation("OwnerChats", fields: [ownerUserId], references: [id])
    chatUser  User    @relation("ChatUserChats", fields: [chatUserId], references: [id])
    listing   Listing @relation(fields: [listingId], references: [id])

    @@unique([chatUserId, ownerUserId, listingId])
}

model Message {
    id        String   @id @default(uuid())
    chatId    String
    message   String
    sender_id String
    createdAt DateTime @default(now())

    // Relations
    chat Chat @relation(fields: [chatId], references: [id])
}

model PlatformMessage {
    id        String   @id @default(uuid())
    chatId    String
    message   String
    sender_id String   @default("platform")
    createdAt DateTime @default(now())

    // Relations
    chat Chat @relation(fields: [chatId], references: [id])
}

// Upstream shape kept verbatim (Admin -> credential intercept queue).
model Credential {
    id                 String   @id @default(uuid())
    listingId          String
    originalCredential Json[]   @default([])
    updatedCredential  Json[]   @default([])
    createdAt          DateTime @default(now())

    // ---- Reachmark extension ------------------------------------------------
    submittedAt DateTime?
    verifiedAt  DateTime?
    verifiedBy  String?
    handover    String?
}

// ---- Reachmark extension ---------------------------------------------------
// The credential chain is the public trust surface: an append-only log of every
// artefact the seller disclosed and every mutation ops made while verifying it.
model CredentialEvent {
    id        String   @id @default(uuid())
    listingId String
    kind      String // submitted | ownership_test | verified | rotated | rolled_back | flagged
    actor     String // seller id | ops user id | "system"
    detail    String?
    hash      String? // sha256 of the artefact bundle at this point in time
    createdAt DateTime @default(now())

    listing Listing @relation(fields: [listingId], references: [id])
}

// Hashed proof artefacts (analytics screenshots, audience exports, reel renders).
model ProofArtifact {
    id        String   @id @default(uuid())
    listingId String
    kind      String // analytics | audience | monetisation | reel
    label     String
    url       String
    sha256    String
    bytes     Int      @default(0)
    createdAt DateTime @default(now())

    listing Listing @relation(fields: [listingId], references: [id])
}

model Transaction {
    id        String   @id @default(uuid())
    listingId String
    ownerId   String
    userId    String
    amount    Float
    isPaid    Boolean  @default(false)
    createdAt DateTime @default(now())

    // ---- Reachmark extension: escrow engine ---------------------------------
    escrowState String?   @default("funded") // funded | testing | chain_confirmed | released | refunded | disputed
    releaseAt   DateTime?
    releasedAt  DateTime?
    disputeId   String?
    feeAmount   Float     @default(0)

    // Relations
    listing Listing @relation(fields: [listingId], references: [id])
}

model Withdrawal {
    id          String   @id @default(uuid())
    userId      String
    amount      Float
    account     Json[]
    isWithdrawn Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    // Relations
    user User @relation(fields: [userId], references: [id])
}
